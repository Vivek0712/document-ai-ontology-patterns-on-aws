   "output": {
    "template": "qi_sum_w2_box1_v1",
    "sparql": "# template: qi_sum_w2_box1_v1\n# purpose:  fin:QualifyingIncome operands: W-2 Box 1 wages per borrower for the latest tax year\n#           (per borrower), with the unit and field each figure came from. graph_hop sums ?wagesBox1\n#           as decimals into `total`; operands come from the ?field IRIs.\n# params:   taxYear  optional  \"\" = latest tax year per borrower; \"2025\" = that tax year only\n# columns:  borrower, taxYear, wagesBox1, unit, field\n# graphs:   FROM clause = TBox graphs + the caller-readable ABox graph urn:rp:graph:abox:{packageId}:{pv}\n# notes:    no inference; the operand concept is read from fin:QualifyingIncome (fin:operandConcept).\nPREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>\nPREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\nPREFIX xsd: <http://www.w3.org/2001/XMLSchema#>\nPREFIX skos: <http://www.w3.org/2004/02/skos/core#>\nPREFIX prov: <http://www.w3.org/ns/prov#>\nPREFIX fin: <urn:rp:ont:fin:>\nPREFIX doc: <urn:rp:ont:doc:>\nPREFIX rp: <urn:rp:ont:rp:>\nSELECT ?borrower ?taxYear ?wagesBox1 ?unit ?field\nFROM <urn:rp:graph:tbox:fibo>\nFROM <urn:rp:graph:tbox:doco>\nFROM <urn:rp:graph:tbox:rp>\nFROM <urn:rp:graph:abox:pkg-lending-01:2.3.1>\nWHERE {\n  fin:QualifyingIncome fin:operandConcept ?operand .\n  ?field a fin:FieldValue ;\n         fin:concept ?operand ;\n         fin:amount ?wagesBox1 ;\n         fin:taxYear ?ty ;\n         fin:borrower ?party ;\n         prov:wasDerivedFrom ?unit .\n  ?unit a doc:EvidenceUnit .\n  ?party rp:name ?borrower .\n  BIND(STR(?ty) AS ?taxYear)\n  {\n    SELECT ?party (MAX(xsd:integer(STR(?y))) AS ?latest)\n    WHERE {\n      fin:QualifyingIncome fin:operandConcept ?op2 .\n      ?f2 a fin:FieldValue ; fin:concept ?op2 ; fin:borrower ?party ; fin:taxYear ?y .\n    }\n    GROUP BY ?party\n  }\n  FILTER(IF(\"\" = \"\", xsd:integer(?taxYear) = ?latest, ?taxYear = \"\"))\n}\nORDER BY ?borrower ?field\n",
    "graphs": [
     "urn:rp:graph:tbox:fibo",

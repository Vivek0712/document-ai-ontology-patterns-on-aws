# -----------------------------------------------------------------------------
# Example environment for the operator scripts, the Makefile and local runs.
#
#   cp .env.example .env      # .env is git-ignored; never commit it
#
# scripts/lib/common.sh loads ./.env automatically. For make targets, export the
# variables in your shell or prefix them on the command line (VAR=value make ...).
#
# Every line below is OPTIONAL. With nothing set:
#   - the offline quickstart (`make e2e-local PII=local`)
#     needs no AWS account and no variables at all;
#   - AWS targets use the standard AWS credential chain and us-east-1.
#
# Never put secrets in this file: no access keys, no passwords. Use IAM Identity
# Center (`aws sso login`), a named profile, or an instance/container role.
# -----------------------------------------------------------------------------


# =============================================================================
# 1. AWS credentials and target
# =============================================================================

# Named profile from ~/.aws/config. Leave unset to use the default credential
# chain (environment variables, SSO cache, default profile, instance role).
# AWS_PROFILE=your-profile

# Region for every AWS target. The reference deployment is tested in us-east-1.
# If you change it: check that Amazon Bedrock AgentCore, Amazon Neptune
# Serverless and every model in config/models.yaml are available there, change
# the model ids (the `us.` prefix is a US cross-Region inference profile) and
# pass matching Availability Zones (see rp:availabilityZones below).
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# The AWS ACCOUNT is not an environment setting here. AWS CDK reads it from
# your active credentials (CDK_DEFAULT_ACCOUNT, set by the CDK CLI). To pin it,
# pass context on the command line instead of editing cdk.json:
#   (cd infra && npx cdk deploy --all -c rp:account=111111111111)
#
# Optional safety guard: operator scripts stop if your credentials resolve to a
# different account. Only the masked form is ever printed.
# RP_EXPECTED_ACCOUNT=111111111111


# =============================================================================
# 2. AWS CDK context (pass with -c key=value, not as environment variables)
# =============================================================================
# Shown here so every parameter is in one place. Defaults live in infra/cdk.json
# or infra/lib/app.ts.
#
#   rp:account              target account        default: current credentials
#   rp:region               target Region         default: us-east-1
#   rp:availabilityZones    two AZs for the VPC   default: us-east-1a,us-east-1b
#                           (fixed so `cdk synth` makes no AWS lookup)
#   rp:doclingImage         docling-serve image, pinned by digest
#   rp:neptuneEngineVersion Amazon Neptune engine version
#   rp:devOrigins           extra CORS origins for the local UI dev server
#                           default: http://localhost:5188,http://localhost:5173
#   rp:askTimeoutMs         /ask integration timeout in ms (default 29000; more
#                           needs an Amazon API Gateway quota increase)
#   rp:aossAdminArns        comma-separated IAM role ARNs given write access to
#                           the Amazon OpenSearch Serverless indexes (pass on the
#                           command line; do not commit ARNs)
#   rp:publicMetrics        on|off  show aggregate evaluation metrics in the API
#                           (default off)
#   rp:buildDir             Lambda build directory (default ../build)
#
# Example, synthesizing without credentials:
#   (cd infra && npx cdk synth --all -c rp:account=000000000000 -c rp:region=us-east-1)


# =============================================================================
# 3. Models (config files, not environment variables)
# =============================================================================
# Model ids live in config/models.yaml under these keys:
#   EMBED_MODEL     Amazon Titan Text Embeddings V2   amazon.titan-embed-text-v2:0
#   MODEL_ANSWER    agent answer model                us.anthropic.claude-sonnet-4-6
#   MODEL_COMPACT   classification tie-break          us.amazon.nova-2-lite-v1:0
#   MODEL_FRONTIER  optional larger-model comparison  us.anthropic.claude-opus-4-6-v1
#
# They are config on purpose: the pipeline config hash recorded with every run
# includes the resolved model ids, so a run can always be traced to the exact
# models it used. Change the YAML, not the environment. Enable model access in
# the Amazon Bedrock console first, and check availability with:
#   aws bedrock list-inference-profiles --region "$AWS_REGION"


# =============================================================================
# 4. Local runs and make variables
# =============================================================================

# PII gate for local pipeline runs: local = regex stand-in, no AWS (quickstart);
# aws = Amazon Comprehend DetectPiiEntities (needs credentials; responses are
# recorded under runs/local/recorded so a rebuild with unchanged inputs replays).
# PII=local

# Sample package for `make units` / `make e2e-local`.
# PACKAGE=data/samples/lending

# Python interpreter used to create .venv (`make venv PY=python3.12`) and by the
# scripts (RP_PY, defaults to .venv/bin/python).
# PY=python3.12
# RP_PY=.venv/bin/python

# Local agent runs on Amazon Bedrock (`make local-ask`): these make paid model
# calls. BUDGET is a hard stop in USD for one invocation.
# QID=q-lend-01
# REPEAT=10
# BUDGET=0.5

# Lambda build directory used by scripts/build_lambdas.sh and the CDK app.
# RP_BUILD_DIR=build

# UI unit tests without the generated mock world (`make mock-world`; not committed). CI sets this.
# RP_ALLOW_MISSING_FIXTURES=1

# Show aggregate evaluation metrics in the local mock world (on|off).
# RP_PUBLIC_METRICS=off


# =============================================================================
# 5. Operator scripts (deploy, seed, reset, teardown)
# =============================================================================

# Skip interactive confirmations (destructive steps still print what they do).
# RP_YES=1

# Stacks deployed in the first CDK pass of scripts/deploy.sh.
# RP_STACKS_CORE="rp-base rp-knowledge rp-ingest"

# Demo user password for the seed script. Leave unset: seed generates one and
# stores it as an SSM SecureString (/rp/demo/password). Never commit a value.
# RP_DEMO_PASSWORD=

# Override any SSM lookup the scripts make, for example when testing against a
# stack you cannot read SSM from. Name = RP_SSM_ + parameter path in upper case
# with / and - replaced by _.  Example for /rp/api-url:
# RP_SSM_RP_API_URL=https://<rest-api-id>.execute-api.us-east-1.amazonaws.com/v1

# An Amazon Cognito access token for scripts that call the API (smoke, eval).
# Leave unset to sign in with the demo user. Never commit a token.
# RP_ACCESS_TOKEN=

# Governance record for an ontology change (`make ontology-check`):
# "reviewer|<pull request URL>|<ISO-8601 time>". Leave unset locally.
# RP_GOVERNANCE_REVIEW=


# =============================================================================
# 6. Runtime settings set by AWS CDK on the deployed functions (reference only)
# =============================================================================
# You do not set these. CDK and scripts/deploy_agentcore.sh set them on the
# AWS Lambda functions and the AgentCore Runtime. The local pipeline sets its own
# values. Listed so you can find what each component reads.
#
#   RP_ENV                    demo | local | test
#   RP_CONFIG_SOURCE          s3 | local  (where pipeline config is read from)
#   RP_REPO_ROOT              repository root for local config reads
#   RP_DATA_BUCKET            Amazon S3 data bucket
#   RP_TABLE_PACKAGES, RP_TABLE_DOCUMENTS, RP_TABLE_DOC_STATUS, RP_TABLE_UNIT_STATUS,
#   RP_TABLE_DOC_ACL, RP_TABLE_RUNS, RP_TABLE_PIPELINE_VERSIONS, RP_TABLE_REVIEW_QUEUE,
#   RP_TABLE_ACCESS_LOG       Amazon DynamoDB table names (default rp-<name>)
#   RP_AOSS_ENDPOINT          Amazon OpenSearch Serverless collection endpoint
#   RP_NEPTUNE_ENDPOINT       Amazon Neptune endpoint
#   RP_DOCLING_URL, RP_DOCLING_QUEUE_URL, RP_DOCLING_CLUSTER, RP_DOCLING_SERVICE,
#   RP_DOCLING_FLOOR_PARAM    docling-serve on AWS Fargate and its scaler
#   RP_STATE_MACHINE_ARN      AWS Step Functions ingestion state machine
#   RP_USER_POOL_ID, RP_USER_POOL_CLIENT_ID   Amazon Cognito
#   RP_AGENT_RUNTIME_ARN, RP_GATEWAY_URL      Amazon Bedrock AgentCore
#   RP_IDENTITY_INJECTION     interceptor | agent_hook (how caller groups reach the tools)
#   RP_GOLDEN_PATH            golden questions file bundled with the agent
#   RP_CORS_ORIGINS           comma-separated allowed origins (never *)
#   RP_GRAPH_HOP_FUNCTION, RP_GRAPH_ADMIN_FUNCTION   Lambda names called by the API
#   RP_ASK_TIMEOUT_SECONDS    /ask time budget
#   RP_XRAY_WHATIF_SIZES      chunk sizes for the X-ray view, e.g. "300,200,128,64"
#   RP_VOCAB_PATH             override path of the vocabulary snapshot
#   RP_PC_QUALIFIER           Lambda alias used for provisioned concurrency (default live)
#   RP_HEARTBEAT_SECONDS, RP_LOG_LEVEL, RP_CODE_SHA

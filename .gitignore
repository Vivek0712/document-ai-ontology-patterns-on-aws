# -----------------------------------------------------------------------------
# .gitignore for the public repository.
#
# Rule of thumb: anything a build, a deploy or a local run writes stays out of
# git. Several of these paths hold account-specific values (account ids, ARNs,
# endpoint ids, home-directory paths) after a build or deploy.
# -----------------------------------------------------------------------------

# --- Never publish -----------------------------------------------------------
# Private working material that must never enter this repository.
internal/
private/
audit/
.tools/

# --- Local secrets and environment ------------------------------------------
.env
.env.*
!.env.example
!**/.env.example
# UI build modes (one line each, VITE_API_MODE only; no secrets)
!**/.env.mock
!**/.env.replay
*.pem
*.key
*.p12
*.pfx
*.crt
# Deployed UI runtime config: real Amazon Cognito pool and client ids, API URL.
**/public/config.json
!**/public/config.example.json
# Private denylist used by scripts/dev/check-denylist.sh (keep it outside the repo).
.denylist
*.denylist.txt
denylist.txt

# --- AWS CDK -----------------------------------------------------------------
# cdk.out holds synthesized templates with the deploying account id baked in.
cdk.out/
**/cdk.out/
# cdk.context.json caches account-specific lookups.
cdk.context.json
**/cdk.context.json
# CDK deploy outputs written by scripts/deploy.sh
cdk-outputs.json

# --- Amazon Bedrock AgentCore starter-toolkit local state (account id, ARNs) --
.bedrock_agentcore/
**/.bedrock_agentcore/
.bedrock_agentcore.yaml
**/.bedrock_agentcore.yaml

# --- Build outputs -----------------------------------------------------------
# build/ holds Lambda bundles, layers, the agent bundle and local pipeline
# worlds. Logs and run metadata in it contain absolute local paths.
build/
**/build/
# Front-end bundles
**/ui/dist/
infra/dist/
# Ontology build output is regenerated by `make ontology-check`; keep the folder.
# (Do not add a bare `dist/` rule: it would make the .gitkeep below impossible to track.)
**/ontology/dist/*
!**/ontology/dist/.gitkeep
*.tsbuildinfo
*.log
infra/*.js
infra/**/*.d.ts
!infra/jest.config.js

# --- Python ------------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.hypothesis/
pip-wheel-metadata/

# --- Node / UI ---------------------------------------------------------------
node_modules/
.npm/
.vite/
**/ui/.vite/
*.local
# Playwright and Vitest output
**/e2e/.results/
playwright-report/
test-results/
coverage/

# --- Evaluation and run outputs ----------------------------------------------
# Only runs/local/ is tracked. `make export-runs` writes records from a deployed
# stack into runs/; they carry real Cognito user ids, session ids and error text
# that can include ARNs. Never commit them unless scrubbed.
/runs/*
!/runs/local/
# Results of local eval runs. Curated evidence goes under eval/fixtures/.
**/eval/results/*.json
!**/eval/results/.gitkeep
# Data generator scratch (the checked-in samples live in data/samples/)
**/data/.cache/

# --- Large regenerable artifacts (generated locally, never committed) --------
# The UI mock world: regenerate with `make xray-fixtures` and `make mock-world`.
**/mock-public/
# Amazon Titan Text Embeddings V2 replay cache (about 4.5 MB): not shipped; a fresh
# clone calls Amazon Bedrock once and records it locally.
**/runs/local/recorded/titan-v2.json
# Release archives built locally
*.tar.zst
*.tar.gz

# --- OS / editors / assistants -----------------------------------------------
.DS_Store
**/.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~
.claude/settings.local.json
CLAUDE.local.md

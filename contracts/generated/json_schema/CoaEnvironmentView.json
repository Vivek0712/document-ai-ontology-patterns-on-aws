    "endpoints": {
      "anyOf": [
        {
          "$ref": "#/$defs/CoaEndpoints"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/CoaError"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "eni": {
      "anyOf": [
        {
          "$ref": "#/$defs/CoaEniRetry"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "history": {
      "items": {
        "$ref": "#/$defs/CoaHistoryEntry"
      },
      "title": "History",
      "type": "array"
    },
    "viewer": {
      "$ref": "#/$defs/CoaViewer"
    },
    "lifecycle": {
      "anyOf": [
        {
          "$ref": "#/$defs/CoaLifecycleInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null

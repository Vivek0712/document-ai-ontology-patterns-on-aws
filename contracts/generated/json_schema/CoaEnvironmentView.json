    "cli": {
      "items": {
        "type": "string"
      },
      "title": "Cli",
      "type": "array"
    },
    "detected": {
      "default": false,
      "title": "Detected",
      "type": "boolean"
    },
    "outcome": {
      "anyOf": [
        {
          "enum": [
            "started",
            "noop",
            "updated",
            "stopped_and_started"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Outcome"
    },
    "note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Note"
    },
    "notice": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notice"
    }
  },
  "required": [
    "deployed",
    "viewer"
  ],
  "title": "CoaEnvironmentView",
  "type": "object"
}

        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failedoperation"
    },
    "version": {
      "default": 0,
      "title": "Version",
      "type": "integer"
    },
    "stateSince": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Statesince"
    },
    "runningSince": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Runningsince"
    },
    "sessionStartedAt": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sessionstartedat"
    },
    "stoppedAt": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stoppedat"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "build": {
      "anyOf": [
        {
          "$ref": "#/$defs/CoaBuild"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "settings": {
      "anyOf": [
        {
          "$ref": "#/$defs/CoaSettings"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "idle": {
      "anyOf": [
        {
          "$ref": "#/$defs/CoaIdleView"
        },
        {
          "type": "null"
        }
      ],
      "default": null

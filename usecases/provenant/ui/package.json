    "class-variance-authority": "0.7.0",
    "clsx": "2.1.1",
    "cmdk": "1.0.0",
    "d3-ease": "3.0.1",
    "d3-interpolate": "3.0.1",
    "d3-shape": "3.2.0",
    "framer-motion": "11.11.17",
    "lucide-react": "0.453.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",

{
  "name": "evidence-workbench-ui",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "description": "Provenant demo app: showcases, workbench, governance screens (mock and live API).",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "replay": "vite --mode replay",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "build:mock": "tsc --noEmit -p tsconfig.json && vite build --mode mock",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "fixtures": "make -C ../../.. mock-world",
    "preview": "vite preview",
    "shots": "node scripts/screenshots.mjs",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test smoke keyboard",
    "e2e:a11y": "playwright test a11y",
    "budget": "node scripts/budget.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "1.1.4",
    "@fontsource-variable/inter": "5.1.0",
    "@fontsource-variable/jetbrains-mono": "5.1.0",
    "@radix-ui/react-dialog": "1.1.2",
    "@radix-ui/react-dropdown-menu": "2.1.2",
    "@radix-ui/react-popover": "1.1.2",
    "@radix-ui/react-scroll-area": "1.2.0",
    "@radix-ui/react-slot": "1.1.0",
    "@radix-ui/react-switch": "1.1.1",
    "@radix-ui/react-tabs": "1.1.1",
    "@radix-ui/react-toggle-group": "1.1.0",
    "@radix-ui/react-tooltip": "1.1.3",
    "@tanstack/react-query": "5.59.0",
